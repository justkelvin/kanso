# Minimal Dolphin Configuration for Kanso
# Clean canvas: hidden menubar (toggle with Ctrl+M), hidden status bar, locked compact toolbar

[General]
BrowseThroughArchives=true
ConfirmClosingMultipleTabs=false
GlobalViewProps=true
ShowFullPath=true
ShowHiddenFiles=false
ShowStatusBar=false
Version=24

[MainWindow]
MenuBar=Disabled
ToolBarsMovable=Disabled

[MainWindow][Toolbar mainToolBar]
IconSize=16
ToolButtonStyle=IconOnly

[PlacesPanel]
IconSize=16

[PreviewSettings]
Plugins=directorythumbnail,imagethumbnail,jpegthumbnail,svgthumbnail
