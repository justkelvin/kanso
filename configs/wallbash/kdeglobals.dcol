$HOME/.config/kdeglobals
[Colors:Window]
BackgroundNormal=<wallbash_pry1_rgb>
ForegroundNormal=<wallbash_txt1_rgb>
BackgroundAlternate=<wallbash_1xa2_rgb>

[Colors:View]
BackgroundNormal=<wallbash_pry1_rgb>
ForegroundNormal=<wallbash_txt1_rgb>
BackgroundAlternate=<wallbash_1xa2_rgb>
DecorationFocus=<wallbash_3xa8_rgb>

[Colors:Selection]
BackgroundNormal=<wallbash_2xa8_rgb>
ForegroundNormal=<wallbash_txt2_rgb>

[Colors:Button]
BackgroundNormal=<wallbash_1xa2_rgb>
ForegroundNormal=<wallbash_txt1_rgb>
